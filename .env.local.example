# ================================================================
# CONFIGURACION DEV (localhost) — apunta a Firebase project DEV
# ================================================================
# IMPORTANTE: Cada entorno usa un Firebase project distinto:
#   localhost  → weather-app-dev-f28ce   (este archivo)
#   Vercel     → weather-app-prod-ef50d  (configurado en Vercel Dashboard)
#
# Nunca uses credenciales de prod en .env.local.
# ================================================================

# AccuWeather API (solo necesaria en localhost)
VITE_ACCUWEATHER_KEY=your_accuweather_api_key_here

# Firebase DEV — credenciales del proyecto weather-app-dev-f28ce
VITE_FIREBASE_API_KEY=your_dev_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=weather-app-dev-f28ce.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=weather-app-dev-f28ce
VITE_FIREBASE_STORAGE_BUCKET=weather-app-dev-f28ce.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_dev_sender_id_here
VITE_FIREBASE_APP_ID=your_dev_app_id_here

# Local dev server
VITE_API_BASE_URL=http://localhost:5173

# Secret para syncWeatherManual (valor de prueba, no usar en prod)
VITE_CRON_SECRET=test-local-secret-123456789
