{
  "name": "pokeweather-functions",
  "description": "Cloud Functions for Pokémon Weather Explorer",
  "type": "module",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "prebuild": "node ../scripts/sync-classify.mjs",
    "build": "tsc",
    "serve": "firebase emulators:start --only functions,firestore",
    "deploy": "firebase deploy --only functions --project prod",
    "deploy:dev": "firebase deploy --only functions --project dev",
    "deploy:prod": "firebase deploy --only functions --project prod",
    "logs": "firebase functions:log",
    "logs:dev": "firebase functions:log --project dev",
    "logs:prod": "firebase functions:log --project prod"
  },
  "main": "lib/index.js",
  "dependencies": {
    "axios": "^1.6.0",
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  }
}
